# ==============================================================================
# .gitignore
# 起動やプレイに影響を与えない開発・環境依存の一時フォルダ・ファイル
# ==============================================================================

# --- OS 生成ファイル ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- エディタ / IDE 設定 ---
.vscode/
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- 開発サーバー / ログ / キャッシュ ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python 一時キャッシュ (http.server 実行時等)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Node.js パッケージ (将来的に使用した場合用)
node_modules/

# 一時作業フォルダ / バックアップ
tmp/
temp/
*.tmp
*.temp
*.bak

# 環境変数 / ローカル秘密情報
.env
.env.local
.env.*.local
